# ==============================================================================
# SOVELA AI ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core System Settings
ENVIRONMENT="development"
DEBUG=true
PROJECT_NAME="Sovela AI Core"
VERSION="0.1.0-alpha"

# Database & Cache
DATABASE_URL="sqlite+aiosqlite:///./sovela_dev.db" # Local SQLite for development; use postgresql+asyncpg for production
REDIS_URL="redis://localhost:6379/0"

# Canonical Active AI Models (Verified Active Snapshots as of Late 2026)
MODEL_TIER1_PRIMARY="gpt-4o-mini-2024-07-18"
MODEL_TIER1_FALLBACK="gemini-3.5-flash-lite"
MODEL_TIER2_SOCRATIC="claude-haiku-5-5"
MODEL_TIER3_COMPLEX="claude-sonnet-5-5"
MODEL_EMBEDDINGS="text-embedding-3-small"

# Latency Abort Trigger
LLM_TTFB_ABORT_THRESHOLD_MS=200

# Provider API Keys
OPENAI_API_KEY="sk-proj-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
GOOGLE_GEMINI_API_KEY="AIzaSy-your-gemini-api-key"

# Compliance & Governance
DPDP_MINIMAL_AGE_LIMIT=18
DAILY_CAPACITY_CAP_HOURS=5.0
